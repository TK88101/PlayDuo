{
    "name": "tk88101/playduo",
    "description": "Play Duo (team development EC site)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "PlayDuo\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.4"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover build/clover.xml --coverage-text",
            "@php tools/coverage_check.php build/clover.xml 80"
        ]
    }
}
